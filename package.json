{
  "name": "pachinko",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/app.ts",
    "./storage/local": "./src/storage/local.ts",
    "./app.css": "./src/app.css"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "vite --config standalone/vite.config.ts",
    "build:standalone": "vite build --config standalone/vite.config.ts",
    "postbuild:standalone": "mv dist/index.html dist/pachinko.html",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "balance": "tsx tools/balance.ts",
    "cels": "node tools/embed-cels.mjs",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^3.0.0"
  }
}
